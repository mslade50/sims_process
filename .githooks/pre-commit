#!/usr/bin/env bash
# Pre-commit guard: refuse to commit a tracked source file that has been
# emptied (0 bytes) when it previously had content.
#
# Triggered after several incidents where OneDrive sync truncated source
# files (notably new_sim.py) in the working tree. Without this guard a
# `git add -A` from a routine workflow would silently stage the wipe.
#
# Bypass (do not use unless intentional): git commit --no-verify

set -u

# File extensions whose accidental wipe would be catastrophic.
GUARDED_EXTS_REGEX='\.(py|md|yml|yaml|json|toml|sh|sql)$'

# Get staged files (Added, Copied, Modified, Renamed); skip Deleted.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

truncated=()
for f in $staged; do
    [[ "$f" =~ $GUARDED_EXTS_REGEX ]] || continue
    # File present in worktree?
    [[ -f "$f" ]] || continue
    # Staged blob size
    blob_hash=$(git ls-files -s -- "$f" | awk '{print $2}')
    [[ -z "$blob_hash" ]] && continue
    blob_size=$(git cat-file -s "$blob_hash" 2>/dev/null || echo "")
    [[ -z "$blob_size" ]] && continue
    if [[ "$blob_size" == "0" ]]; then
        # Was it 0 bytes at HEAD already? If yes, allow (intentional empty file).
        if git rev-parse --verify HEAD:"$f" >/dev/null 2>&1; then
            head_size=$(git cat-file -s "HEAD:$f" 2>/dev/null || echo "")
            if [[ -n "$head_size" && "$head_size" != "0" ]]; then
                truncated+=("$f (was $head_size bytes, now 0)")
            fi
        fi
    fi
done

if (( ${#truncated[@]} > 0 )); then
    echo "ERROR: Refusing to commit — these guarded files were truncated to 0 bytes:"
    for entry in "${truncated[@]}"; do
        echo "  - $entry"
    done
    echo ""
    echo "This is the OneDrive-truncation pattern. To recover:"
    echo "  git checkout HEAD -- <file>"
    echo ""
    echo "If the empty file is genuinely intentional, bypass with: git commit --no-verify"
    exit 1
fi

exit 0
