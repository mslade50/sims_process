{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "golf-model-dashboard",
  "account_id": "ba4875f01f2bc46dd48e1e26d2ec9080",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Single source of truth for everything the deploy ships. `npm run deploy:cloudflare` and
  // .github/workflows/deploy-cloudflare-dashboard.yml both build from this file (vite.config.ts no longer injects bindings).
  // One cron every 15 minutes; must equal SCHEDULE_CRONS in worker/cron-rules.ts (tests/wrangler-config.test.mjs enforces it).
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "r2_buckets": [
    { "binding": "DASHBOARD_DATA", "bucket_name": "golf-model-dashboard-data" },
    // The repair watcher's inbox bucket (tools/watcher/runtime.py lists ops/agent_inbox/). worker/freshness.ts writes ops/agent_inbox/dashboard-freshness/** only.
    { "binding": "AGENT_INBOX", "bucket_name": "golf-odds-board" }
  ],
  // Cloudflare Access application protecting workers.dev (public identifiers, not secrets). Required by worker/access.ts.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "denaliassetmanagement.cloudflareaccess.com",
    "ACCESS_AUD": "6373d69c743a8032630161ae31dcd2031bf98dae6b7e186a40078bc4390f2ae0",
    // Owners (worker/owner.ts): only these Access users see Run, weather edits and overrides. Colleagues added in Access see the rest.
    "OWNER_EMAILS": "mckinleyslade@gmail.com",
    // Feature switches, declared here so a deploy never silently resets a value set in the Cloudflare dashboard: turning one on is a reviewed config change ("1" = on, anything else = off).
    // LEGACY_ALERTS_ENABLED: kill switch for the legacy P1/P2/P3 Telegram alerts (worker/alerts.ts); they also need both TELEGRAM_* secrets.
    "LEGACY_ALERTS_ENABLED": "0",
    // OPS_SHADOW_ENABLED: passive shadow observer (worker/shadow.ts); reads R2, writes ops/shadow/** only, sends nothing.
    "OPS_SHADOW_ENABLED": "0",
    // DATA_FRESHNESS_ENABLED: data-staleness check on the 15-minute cron (worker/freshness.ts); read-only on data, writes owner/data_freshness.json and agent-inbox records, never Telegram.
    "DATA_FRESHNESS_ENABLED": "1"
  }
}
